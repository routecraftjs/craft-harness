# @envFlag=APP_ENV
# ---
# Environment contract for the harness.
#
# Every variable the project reads is declared here, with what it is for and
# whether it must be set. Values never live in this file: it is committed, and
# `.env` is not. `env.ts` parses the same set at boot, and a test fails the
# build when the two drift apart.
# ---

# @optional @type=enum(development, test, production)
# Deployment mode. Outside development and test the MCP transport requires
# MCP_URL to be HTTPS, which is why `bun run dev` sets this to development and
# a real deployment does not.
NODE_ENV=development

# @required @sensitive @type=string
# API key for the model provider named by LLM_PROVIDER. The one value a fresh
# scaffold must set before anything involving a model will run.
LLM_API_KEY=

# @optional @type=enum(anthropic, openai, gemini, openrouter, ollama, lmstudio)
# Which provider LLM_API_KEY belongs to.
LLM_PROVIDER=anthropic

# @optional @type=string
# Model the agent and the llm() steps use, without the provider prefix.
LLM_MODEL=claude-sonnet-4-5

# @required @type=string
# Comma-separated allowlist of hosts web-fetch may reach. There is no default
# and no wildcard: an unset value means the capability refuses every URL, so a
# fresh scaffold performs no egress until someone decides where it may go.
# Example: docs.routecraft.dev,en.wikipedia.org
WEB_FETCH_ALLOWED_HOSTS=

# @optional @sensitive @type=string
# Brave Search API key. Absent, web-search refuses rather than searching.
BRAVE_SEARCH_API_KEY=

# @optional @type=string
# Cron expression driving the scheduler tick. Six fields adds seconds, which
# is how CI makes the boot check finish in under a minute.
SCHEDULER_CRON=* * * * *

# @optional @type=boolean
# Whether the heartbeat route asks the agent for work on a timer. Off by
# default: an agent that wakes itself up costs money while you sleep.
HEARTBEAT_ENABLED=false

# @optional @type=number
# Milliseconds between heartbeats when HEARTBEAT_ENABLED is true.
HEARTBEAT_INTERVAL_MS=3600000

# @required @sensitive @type=string
# Secret the suspension store signs resume tokens with. At least 32 bytes:
# a resume token is a bearer capability and its holder can guess the secret
# offline without limit. Generate one with `openssl rand -base64 32`. Anyone
# holding it can mint a link that approves a parked request.
ROUTECRAFT_SUSPENSION_SECRET=

# @optional @type=string
# Public base URL approval links are built against. Must be reachable by
# whoever approves; the loopback default only works on your own machine.
APPROVAL_BASE_URL=http://localhost:8081

# @optional @type=string
# Comma-separated `subject=scope scope` entries naming who may resolve an
# approval and what they may approve. Empty means nobody can, which is the
# right default for a harness nobody has configured yet.
APPROVERS=

# @optional @type=number
# Port for the HTTP surface that serves approval links.
HTTP_PORT=8081

# @optional @type=number
# Port for the MCP transport an assistant connects to.
MCP_PORT=8082

# @optional @type=url
# Public URL of the MCP transport, which is also its RFC 9728 resource
# identifier. Must be the address a client actually reaches; behind a proxy
# that is the proxy's address, not this process's port.
MCP_URL=http://localhost:8082

# @optional @type=number
# Port for the ops surface `craft exec` and `craft ops` talk to. 8080 is where
# those commands look by default; moving it means passing --url every time.
OPS_PORT=8080

# @optional @type=email
# Mailbox the harness reads and replies from. Set this and MAIL_APP_PASSWORD
# together to activate the mail capabilities; until both exist the mail routes
# are never constructed.
MAIL_ADDRESS=

# @optional @sensitive @type=string
# App passcode for MAIL_ADDRESS. Not the account password: Gmail and friends
# issue a separate credential for IMAP and SMTP.
MAIL_APP_PASSWORD=

# @optional @type=string
# IMAP host for MAIL_ADDRESS. Prefilled for Gmail.
MAIL_IMAP_HOST=imap.gmail.com

# @optional @type=string
# SMTP host for MAIL_ADDRESS. Prefilled for Gmail.
MAIL_SMTP_HOST=smtp.gmail.com

# @optional @type=number
# SMTP port. 587 is Gmail's STARTTLS submission port.
MAIL_SMTP_PORT=587

# @optional @type=string
# IMAP folder the inbox route polls.
MAIL_FOLDER=INBOX
